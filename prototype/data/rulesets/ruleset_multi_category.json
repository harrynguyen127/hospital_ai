    "role": ["dieu_duong", "bac_si"],
    "validation_rules": [
      {
        "field": "mach",
        "type": "range",
        "min": 30,
        "max": 220,
        "error_message": "Chỉ số mạch ngoài khoảng hợp lý (30 - 220 lần/phút)"
      },
      {
        "field": "spo2",
        "type": "range",
        "min": 50,
        "max": 100,
        "error_message": "Chỉ số SpO2 phải từ 50% đến 100%"
