# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN HOSPITAL_AI
# ==========================================
# Hiện tại dự án đang chạy 100% Local (offline tại máy).
# Các cấu hình gọi Cloud API bên dưới được giữ lại ở dạng comment khi cần bật lại.

# ------------------------------------------
# 1. CẤU HÌNH SERVER CHUNG
# ------------------------------------------
# Cổng chạy HTTP server (mặc định: 8765 -> http://127.0.0.1:8765)
PORT=8765

# Thư mục lưu trạng thái runtime demo (mặc định: prototype/.runtime)
# PROTO_RUNTIME_DIR=.runtime

# ------------------------------------------
# 2. VOICE INPUT: SPEECH-TO-TEXT LOCAL (ĐANG SỬ DỤNG)
# ------------------------------------------
# Mô hình PhoWhisper chạy local tại máy (mặc định: vinai/PhoWhisper-small)
# Có thể đổi sang: vinai/PhoWhisper-tiny (nếu máy yếu)
PHOWHISPER_MODEL=vinai/PhoWhisper-small

# ------------------------------------------
# 3. [TẠM TẮT] VOICE INPUT: BÓC TÁCH VÀO FORM QUA LLM API (Slot voice.send)
# ------------------------------------------
# VOICE_API_KEY=
# VOICE_API_URL=https://api.openai.com/v1/chat/completions
# VOICE_MODEL=gpt-4o-mini
# VOICE_TIMEOUT=3.0

# ------------------------------------------
# 4. [TẠM TẮT] VOICE INPUT: CLOUD STT BLAZE.VN
# ------------------------------------------
# BLAZE_API_KEY=
# BLAZE_API_URL=https://api.blaze.vn/v1/stt/execute
# BLAZE_STT_MODEL=stt-async-1.5
